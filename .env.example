APP_ENV=development
POSTGRES_DB=merchant_ai
POSTGRES_USER=merchant
POSTGRES_PASSWORD=merchant
DATABASE_URL=postgresql+psycopg://merchant:merchant@localhost:5432/merchant_ai

# Local demo credentials only. Replace with private random values outside local development.
SERVICE_API_KEY=local-demo-service-key
OPERATOR_API_KEYS={"op-demo":"local-demo-operator-key"}

# Tools: only "mock" exists. "real" intentionally refuses to start (no production Paytm APIs).
TOOL_BACKEND=mock

# Planner: "rules" (offline, deterministic) or "llm" (Groq; requires GROQ_API_KEY).
# llm uses Groq when GROQ_API_KEY is configured and automatically falls back to safe rules on error.
PLANNER_BACKEND=rules
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Voice: disabled by default; Sarvam credentials stay in this backend-only .env.
VOICE_BACKEND=off
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_TTS_SPEAKER=shubh_enhi_ads
VOICE_MAX_AUDIO_BYTES=5000000
VOICE_TIMEOUT_SECONDS=30
